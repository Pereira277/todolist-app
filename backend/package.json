{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "esbuild src/handlers/me.ts src/handlers/lists.ts src/handlers/tasks.ts --bundle --platform=node --target=node24 --format=esm --main-fields=module,main --outdir=dist --out-extension:.js=.mjs",
    "package": "npm run build && cd dist && rm -f *.zip && zip -q me.zip me.mjs && zip -q lists.zip lists.mjs && zip -q tasks.zip tasks.mjs && cd ..",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.157",
    "@types/node": "^24.19.2",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1155.0",
    "@aws-sdk/lib-dynamodb": "^3.1155.0"
  }
}
